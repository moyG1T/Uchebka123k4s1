<UserControl x:Class="Uchebka123k4s1.Views.OrderControllerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Uchebka123k4s1.Views" xmlns:viewmodels="clr-namespace:Uchebka123k4s1.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:OrderControlViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <Grid>
            <Border Background="{StaticResource Blue}"/>
            <TextBlock Text="Контроль" Foreground="White" HorizontalAlignment="Center"/>
            <Button Command="{Binding GoBackCommand}" Content="Назад" HorizontalAlignment="Left" Style="{StaticResource TextButton}"/>
            <Button Command="{Binding LogoutCommand}" Content="Выйти" HorizontalAlignment="Right" Style="{StaticResource TextButton}"/>
        </Grid>

        <ScrollViewer Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Top"
                      VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.IsVirtualizing="True"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380" Margin="0 10 0 50">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Качество"/>
                    <ComboBox SelectedItem="{Binding SelectedController}"
                              ItemsSource="{Binding Controllers}"
                              DisplayMemberPath="Title"
                              IsEditable="True"/>
                    <Button Command="{Binding AddControlCommand}" Content="+" 
                            Style="{StaticResource ElevatedButton}" Margin="10 0"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding OrderControllers}" HorizontalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0 4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsFine}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Controller.Title}"/>
                                <TextBox Grid.Column="2" Text="{Binding Comm, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Command="{Binding DataContext.RemoveControlCommand,
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                        CommandParameter="{Binding}"
                                        Grid.Column="3" Content="x" Style="{StaticResource ElevatedButton}" HorizontalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
            <Button 
                Command="{Binding SaveChangesCommand}"
                Content="Сохранить" Style="{StaticResource ElevatedButton}"/>
            <Button
                Command="{Binding SetReadyCommand}" Foreground="{StaticResource Red}"
                Content="Контроль выполнен" Style="{StaticResource TextButton}"/>
        </StackPanel>
    </Grid>
</UserControl>
